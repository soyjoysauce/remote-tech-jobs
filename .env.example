# Copy to .env.local and fill in. Names only; never commit real values.

# Supabase. NEXT_PUBLIC_* values are bundled into browser code, so only put public values there.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
# The secret key bypasses row level security, so it is only for ingestion scripts and server code.
SUPABASE_SECRET_KEY=
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
RESEND_API_KEY=
